{
  "name": "video-downloader",
  "version": "8.5.1",
  "description": "全平台视频内容解析与下载工具",
  "main": "server.js",
  "scripts": {
    "dev": "node server.js",
    "start": "node server.js",
    "test": "node --test tests/*.test.js",
    "build-win": "pkg . --targets node18-win-x64 --output video-downloader.exe",
    "build-mac": "pkg . --targets node18-macos-x64 --output video-downloader-mac"
  },
  "dependencies": {
    "axios": "^1.7.0",
    "express": "^4.21.0",
    "node-cron": "^4.2.1",
    "playwright": "^1.59.1",
    "playwright-extra": "^4.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "uuid": "^11.1.1"
  },
  "bin": "server.js",
  "pkg": {
    "assets": [
      "public/**/*",
      "lib/**/*.js"
    ],
    "targets": [
      "node18-win-x64",
      "node18-macos-x64"
    ]
  },
  "devDependencies": {
    "pkg": "^5.8.1"
  }
}
